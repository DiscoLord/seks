.{
    .name = .seks,
    // `seks --version` prints this value.
    .version = "0.1.0",
    // The Zig toolchain made this id when the package was created. It never
    // changes. Changing it has security and trust implications.
    .fingerprint = 0x59d74b4fc28ac18c,
    .minimum_zig_version = "0.17.0",
    .dependencies = .{},
    // The files of the package. A directory includes all files in it.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "completions",
        "data",
        "src",
        "LICENSE",
        "README.md",
    },
}
