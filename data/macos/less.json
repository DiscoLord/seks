          "effect": "Delete next character"
        },
        {
          "id": 56,
          "keys": [
            "Ctrl+U"
          ],
          "effect": "Clear input line"
        },
        {
          "id": 57,
          "keys": [
            "Up"
          ],
          "effect": "Previous input history entry"
        },
        {
          "id": 58,
          "keys": [
            "Down"
          ],
          "effect": "Next input history entry"
        },
        {
          "id": 59,
          "keys": [
            "Tab"
