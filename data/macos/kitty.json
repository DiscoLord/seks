{
  "full_name": "kitty",
  "note": "kitty 0.49.2 defaults; kitty_mod = Ctrl+Shift.",
  "source": "https://github.com/kovidgoyal/kitty/blob/v0.49.2/kitty/options/definition.py",
  "binding_groups": [
    {
      "id": 1,
      "title": "Clipboard",
      "note": "Selection shortcuts need selected text; on macOS Cmd+C passes through when nothing is selected.",
      "bindings": [
        {
          "id": 1,
          "keys": [
            "Ctrl+Shift+C"
          ],
          "effect": "Copy to clipboard"
        },
        {
          "id": 2,
          "keys": [
            "Cmd+C"
          ],
          "effect": "Copy selection; otherwise pass key through"
        },
        {
          "id": 3,
          "keys": [
            "Ctrl+Shift+V",
            "Cmd+V"
          ],
          "effect": "Paste from clipboard"
        },
        {
          "id": 4,
          "keys": [
            "Ctrl+Shift+S",
            "Shift+Insert"
          ],
          "effect": "Paste from selection"
        },
        {
          "id": 5,
          "keys": [
            "Ctrl+Shift+O"
          ],
          "effect": "Open selection with system handler"
        }
      ]
    },
    {
      "id": 2,
      "title": "Scrolling",
      "note": "Prompt jumps and last-command output require shell integration.",
      "bindings": [
        {
          "id": 6,
          "keys": [
            "Ctrl+Shift+Up",
            "Ctrl+Shift+K",
            "Cmd+Opt+PageUp",
            "Cmd+Up"
          ],
          "effect": "Scroll line up"
        },
        {
          "id": 7,
          "keys": [
            "Ctrl+Shift+Down",
            "Ctrl+Shift+J",
            "Cmd+Opt+PageDown",
            "Cmd+Down"
          ],
          "effect": "Scroll line down"
        },
        {
          "id": 8,
          "keys": [
            "Ctrl+Shift+PageUp",
            "Cmd+PageUp"
          ],
          "effect": "Scroll page up"
        },
        {
          "id": 9,
          "keys": [
            "Ctrl+Shift+PageDown",
            "Cmd+PageDown"
          ],
          "effect": "Scroll page down"
        },
        {
          "id": 10,
          "keys": [
            "Ctrl+Shift+Home",
            "Cmd+Home"
          ],
          "effect": "Scroll to top"
        },
        {
          "id": 11,
          "keys": [
            "Ctrl+Shift+End",
            "Cmd+End"
          ],
          "effect": "Scroll to bottom"
