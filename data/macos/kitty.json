        {
          "id": 15,
          "keys": [
            "Ctrl+Shift+G"
          ],
          "effect": "Browse output of the last shell command in pager"
        },
        {
          "id": 16,
          "keys": [
            "Ctrl+Shift+/",
            "Cmd+F"
          ],
          "effect": "Search the scrollback within a pager"
        }
      ]
