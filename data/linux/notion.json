{
  "full_name": "Notion",
  "source": "https://www.notion.com/help/keyboard-shortcuts",
  "note": "English/QWERTY shortcuts. Linux uses the web app; focus the page editor to avoid browser shortcut conflicts. Includes contextual table, block and inline-menu shortcuts; slash-command names are not enumerated.",
  "binding_groups": [
    {
      "id": 1,
      "title": "Find and navigate",
      "bindings": [
        {
          "id": 1,
          "keys": [
            "Ctrl+P",
            "Ctrl+K"
          ],
          "effect": "Page search"
        },
        {
          "id": 2,
          "keys": [
            "Ctrl+F"
          ],
          "effect": "Find on page"
        },
        {
          "id": 3,
          "keys": [
            "Ctrl+["
          ],
          "effect": "Back"
        },
        {
          "id": 4,
          "keys": [
            "Ctrl+]"
          ],
          "effect": "Forward"
        },
        {
          "id": 5,
          "keys": [
            "Ctrl+Shift+U"
          ],
          "effect": "Parent page"
        },
        {
          "id": 6,
          "keys": [
            "Ctrl+Shift+L"
          ],
          "effect": "Toggle theme"
        }
      ],
      "note": "Use page search outside a text selection; with text selected, Cmd/Ctrl+K inserts a link."
    },
