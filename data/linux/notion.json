      "bindings": [
        {
          "id": 16,
          "keys": [
            "Ctrl+Shift+0"
          ],
          "effect": "Text"
        },
        {
          "id": 17,
          "keys": [
            "Ctrl+Shift+1"
          ],
          "effect": "Heading 1"
        },
        {
          "id": 18,
          "keys": [
            "Ctrl+Shift+2"
          ],
          "effect": "Heading 2"
        },
        {
          "id": 19,
          "keys": [
            "Ctrl+Shift+3"
          ],
          "effect": "Heading 3"
        },
        {
          "id": 20,
          "keys": [
            "Ctrl+Shift+4"
          ],
          "effect": "Checkbox"
        },
        {
          "id": 21,
          "keys": [
            "Ctrl+Shift+5"
          ],
          "effect": "Bullets"
        },
        {
          "id": 22,
          "keys": [
            "Ctrl+Shift+6"
          ],
          "effect": "Numbered list"
        },
        {
          "id": 23,
          "keys": [
            "Ctrl+Shift+7"
          ],
          "effect": "Toggle list"
        },
        {
          "id": 24,
          "keys": [
            "Ctrl+Shift+8"
          ],
          "effect": "Code block"
        },
        {
          "id": 25,
          "keys": [
            "Ctrl+Shift+9"
          ],
          "effect": "Page"
        }
      ],
      "note": "With the cursor in a block or a block selected."
    },
    {
      "id": 4,
      "title": "Arrange blocks",
      "bindings": [
        {
          "id": 26,
          "keys": [
            "Esc"
          ],
          "effect": "Select or deselect block"
        },
        {
          "id": 27,
          "keys": [
            "Ctrl+D"
          ],
          "effect": "Duplicate"
        },
        {
          "id": 28,
          "keys": [
            "Ctrl+/"
          ],
          "effect": "Block actions"
        },
        {
          "id": 29,
          "keys": [
            "Tab"
          ],
          "effect": "Indent"
        },
        {
          "id": 30,
          "keys": [
            "Shift+Tab"
          ],
          "effect": "Outdent"
        },
        {
          "id": 31,
          "keys": [
            "Ctrl+Shift+Up"
          ],
          "effect": "Move up"
        },
        {
          "id": 32,
          "keys": [
            "Ctrl+Shift+Down"
          ],
          "effect": "Move down"
        },
        {
          "id": 33,
          "keys": [
            "Ctrl+Enter"
          ],
          "effect": "Activate block"
        },
        {
          "id": 34,
          "keys": [
            "Ctrl+Alt+T"
          ],
          "effect": "Expand or collapse toggles"
        }
      ],
      "note": "Select blocks first. Activate opens pages, toggles checkboxes or lists, or expands images and embeds."
    }
  ]
}
