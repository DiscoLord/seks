{
  "full_name": "Notion",
  "source": "https://www.notion.com/help/keyboard-shortcuts",
  "note": "English/QWERTY shortcuts. Linux uses the web app; focus the page editor to avoid browser shortcut conflicts.",
  "binding_groups": [
    {
      "id": 1,
      "title": "Find and navigate",
      "bindings": [
        {
          "id": 1,
          "keys": [
            "Ctrl+P",
            "Ctrl+K"
          ],
          "effect": "Page search"
        },
        {
          "id": 2,
          "keys": [
            "Ctrl+F"
          ],
          "effect": "Find on page"
        },
        {
          "id": 3,
          "keys": [
            "Ctrl+["
          ],
          "effect": "Back"
        },
        {
          "id": 4,
          "keys": [
            "Ctrl+]"
          ],
          "effect": "Forward"
        },
        {
          "id": 5,
          "keys": [
            "Ctrl+Shift+U"
          ],
          "effect": "Parent page"
        },
        {
          "id": 6,
          "keys": [
            "Ctrl+Shift+L"
          ],
          "effect": "Toggle theme"
        }
      ],
      "note": "Use page search outside a text selection; with text selected, Cmd/Ctrl+K inserts a link."
    },
    {
      "id": 2,
      "title": "Text and comments",
      "bindings": [
        {
          "id": 7,
          "keys": [
            "Shift+Enter"
          ],
          "effect": "Line break"
        },
        {
          "id": 8,
          "keys": [
            "Ctrl+B"
          ],
          "effect": "Bold"
        },
        {
          "id": 9,
          "keys": [
            "Ctrl+I"
          ],
          "effect": "Italic"
        },
        {
          "id": 10,
          "keys": [
            "Ctrl+U"
          ],
          "effect": "Underline"
        },
        {
          "id": 11,
          "keys": [
            "Ctrl+Shift+S"
          ],
          "effect": "Strikethrough"
        },
        {
          "id": 12,
          "keys": [
            "Ctrl+E"
          ],
          "effect": "Inline code"
        },
        {
          "id": 13,
          "keys": [
            "Ctrl+K"
          ],
          "effect": "Insert link"
        },
        {
          "id": 14,
          "keys": [
            "Ctrl+Shift+Ctrl"
          ],
          "effect": "Comment"
        },
        {
          "id": 15,
          "keys": [
            "Ctrl+Shift+H"
          ],
          "effect": "Reuse last color"
        }
      ],
      "note": "Formatting and links apply to selected text."
    },
    {
