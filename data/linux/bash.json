{
  "aliases": [
    "readline"
  ],
  "full_name": "Bash / Readline",
  "note": "Bash prompt with standard Readline bindings; Emacs and vi modes are separate.",
  "source": "https://tiswww.case.edu/php/chet/readline/rluserman.html",
  "binding_groups": [
    {
      "id": 1,
      "title": "Emacs mode: movement",
      "note": "Applies to the Emacs keymap. Alt must reach the application as Meta/Esc.",
      "bindings": [
        {
          "id": 1,
          "keys": [
            "Ctrl+A"
          ],
          "effect": "Line start"
        },
        {
          "id": 2,
          "keys": [
            "Ctrl+E"
          ],
          "effect": "Line end"
        },
        {
          "id": 3,
          "keys": [
            "Ctrl+B"
          ],
          "effect": "Previous character"
        },
        {
          "id": 4,
          "keys": [
            "Ctrl+F"
          ],
          "effect": "Next character"
        },
        {
          "id": 5,
          "keys": [
            "Alt+B"
          ],
          "effect": "Previous word"
        },
        {
          "id": 6,
          "keys": [
            "Alt+F"
          ],
          "effect": "Next word end"
        },
        {
          "id": 7,
          "keys": [
            "Ctrl+X Ctrl+X"
          ],
          "effect": "Swap cursor and mark"
        }
      ]
    },
    {
      "id": 2,
      "title": "Emacs mode: editing",
      "note": "Cut text is saved in the shell’s kill ring, not the system clipboard.",
      "bindings": [
        {
          "id": 8,
          "keys": [
            "Backspace"
          ],
          "effect": "Delete previous character"
        },
        {
          "id": 9,
          "keys": [
            "Ctrl+D"
          ],
          "effect": "Delete character; at empty prompt, signal end of input"
        },
        {
          "id": 10,
          "keys": [
            "Ctrl+K"
          ],
          "effect": "Cut from cursor to line end"
        },
        {
          "id": 11,
          "keys": [
            "Ctrl+U"
          ],
          "effect": "Cut from cursor to line start"
        },
        {
          "id": 12,
          "keys": [
            "Ctrl+W"
          ],
          "effect": "Cut preceding whitespace-delimited word"
        },
        {
          "id": 13,
          "keys": [
            "Alt+Backspace"
          ],
          "effect": "Cut preceding word"
        },
        {
          "id": 14,
          "keys": [
            "Alt+D"
          ],
          "effect": "Cut next word"
        },
        {
          "id": 15,
          "keys": [
            "Ctrl+Y"
          ],
          "effect": "Paste latest kill-ring entry"
        },
        {
          "id": 16,
          "keys": [
            "Alt+Y"
          ],
          "effect": "Cycle earlier kill-ring entries after pasting"
        },
        {
          "id": 17,
          "keys": [
            "Ctrl+T"
          ],
          "effect": "Transpose characters"
        },
        {
          "id": 18,
          "keys": [
            "Alt+T"
          ],
          "effect": "Transpose words"
        },
        {
          "id": 19,
          "keys": [
            "Alt+U"
          ],
          "effect": "Uppercase word"
        },
        {
          "id": 20,
          "keys": [
            "Alt+L"
          ],
          "effect": "Lowercase word"
        },
        {
          "id": 21,
          "keys": [
            "Alt+C"
          ],
          "effect": "Capitalize word"
        },
        {
          "id": 22,
          "keys": [
            "Ctrl+_",
            "Ctrl+X Ctrl+U"
          ],
          "effect": "Undo edit"
        },
        {
          "id": 23,
          "keys": [
            "Alt+R"
          ],
          "effect": "Restore original history line"
        },
        {
          "id": 24,
          "keys": [
            "Ctrl+V"
          ],
          "effect": "Insert next character literally"
        }
      ]
    },
    {
      "id": 3,
      "title": "Emacs mode: history",
      "note": "Ctrl+S may be intercepted by terminal flow control.",
      "bindings": [
        {
          "id": 25,
          "keys": [
            "Ctrl+P"
          ],
          "effect": "Previous history entry"
        },
        {
          "id": 26,
          "keys": [
            "Ctrl+N"
          ],
          "effect": "Next history entry"
        },
        {
          "id": 27,
          "keys": [
            "Ctrl+R"
          ],
          "effect": "Search history backward incrementally"
        },
        {
          "id": 28,
          "keys": [
            "Ctrl+S"
          ],
          "effect": "Search history forward incrementally"
        },
        {
          "id": 29,
          "keys": [
            "Alt+P"
          ],
          "effect": "Search history backward after entering a query"
        },
        {
          "id": 30,
          "keys": [
            "Alt+N"
          ],
          "effect": "Search history forward after entering a query"
        },
        {
          "id": 31,
          "keys": [
            "Alt+<"
          ],
          "effect": "Oldest history entry"
        },
        {
          "id": 32,
          "keys": [
            "Alt+>"
          ],
          "effect": "Return to current input after history"
        },
        {
          "id": 33,
          "keys": [
            "Alt+.",
            "Alt+_"
          ],
          "effect": "Insert last argument from previous command"
        },
        {
          "id": 34,
          "keys": [
            "Ctrl+O"
          ],
          "effect": "Accept line and recall next history entry"
        }
      ]
    },
    {
      "id": 4,
      "title": "Emacs mode: completion",
      "note": "Completion candidates depend on the shell’s configured completion system.",
      "bindings": [
        {
          "id": 35,
          "keys": [
            "Tab"
          ],
          "effect": "Complete current word"
        },
        {
          "id": 36,
          "keys": [
            "Alt+?"
          ],
          "effect": "List possible completions"
        },
        {
          "id": 37,
          "keys": [
            "Alt+*"
          ],
          "effect": "Insert all possible completions"
        }
      ]
    },
    {
      "id": 5,
      "title": "Emacs mode: prompt controls",
      "bindings": [
        {
          "id": 38,
          "keys": [
            "Enter"
          ],
          "effect": "Accept current input"
        },
        {
          "id": 39,
          "keys": [
            "Ctrl+G"
          ],
          "effect": "Abort current editing operation"
        },
        {
          "id": 40,
          "keys": [
            "Ctrl+L"
          ],
          "effect": "Clear display and redraw input"
        },
        {
          "id": 41,
          "keys": [
            "Ctrl+X ("
          ],
          "effect": "Start recording keyboard macro"
        },
        {
          "id": 42,
          "keys": [
            "Ctrl+X )"
          ],
          "effect": "Stop recording keyboard macro"
        },
        {
          "id": 43,
          "keys": [
            "Ctrl+X e"
          ],
          "effect": "Replay last keyboard macro"
        }
      ]
    },
    {
      "id": 6,
      "title": "Vi mode: insert",
      "note": "Only when vi editing is enabled; each new prompt starts in insert mode.",
      "bindings": [
        {
          "id": 44,
          "keys": [
            "Esc"
          ],
          "effect": "Enter vi command mode"
        },
        {
          "id": 45,
          "keys": [
            "Enter"
          ],
          "effect": "Accept current input"
        },
        {
          "id": 46,
          "keys": [
            "Backspace"
          ],
          "effect": "Delete previous character"
        },
        {
          "id": 47,
          "keys": [
            "Ctrl+W"
          ],
          "effect": "Cut preceding word"
        },
        {
          "id": 48,
          "keys": [
            "Ctrl+U"
          ],
          "effect": "Cut back to line start"
        },
        {
          "id": 49,
          "keys": [
            "Tab"
          ],
          "effect": "Complete current word"
        }
      ]
    },
    {
      "id": 7,
      "title": "Vi mode: movement and history",
      "note": "Press Esc from vi insert mode. Search direction follows shell history, not file navigation.",
      "bindings": [
        {
          "id": 50,
          "keys": [
            "h"
          ],
          "effect": "Previous character"
        },
        {
          "id": 51,
          "keys": [
            "l"
          ],
          "effect": "Next character"
        },
        {
          "id": 52,
          "keys": [
            "w"
          ],
          "effect": "Next word start"
        },
        {
          "id": 53,
          "keys": [
            "b"
          ],
          "effect": "Previous word start"
        },
        {
          "id": 54,
          "keys": [
            "e"
          ],
          "effect": "Word end"
        },
        {
          "id": 55,
          "keys": [
            "0"
          ],
          "effect": "Line start"
        },
        {
          "id": 56,
          "keys": [
            "^"
          ],
          "effect": "First nonblank"
        },
        {
          "id": 57,
          "keys": [
            "$"
          ],
          "effect": "Line end"
        },
        {
          "id": 58,
          "keys": [
            "f"
          ],
          "effect": "Then character: find forward"
        },
        {
          "id": 59,
          "keys": [
            "F"
          ],
          "effect": "Then character: find backward"
        },
        {
          "id": 60,
          "keys": [
            "t"
          ],
          "effect": "Then character: stop before it forward"
        },
        {
          "id": 61,
          "keys": [
            "T"
          ],
          "effect": "Then character: stop after it backward"
        },
        {
          "id": 62,
          "keys": [
            ";"
          ],
          "effect": "Repeat character find"
        },
        {
          "id": 63,
          "keys": [
            ","
          ],
          "effect": "Reverse character find"
        },
        {
          "id": 64,
          "keys": [
            "k"
          ],
          "effect": "Older history entry"
        },
        {
          "id": 65,
          "keys": [
            "j"
          ],
          "effect": "Newer history entry"
        },
        {
          "id": 66,
          "keys": [
            "/"
          ],
          "effect": "Enter backward history search"
        },
        {
          "id": 67,
          "keys": [
            "?"
          ],
          "effect": "Enter forward history search"
        },
        {
          "id": 68,
          "keys": [
            "n"
          ],
          "effect": "Repeat history search"
        },
        {
          "id": 69,
          "keys": [
            "N"
          ],
          "effect": "Reverse history search"
        }
      ]
    },
    {
      "id": 8,
      "title": "Vi mode: editing",
      "note": "Command mode after Esc; operators d, c and y can also be followed by a motion.",
      "bindings": [
        {
          "id": 70,
          "keys": [
            "i"
          ],
          "effect": "Insert before cursor"
        },
        {
          "id": 71,
          "keys": [
            "a"
          ],
          "effect": "Insert after cursor"
        },
        {
          "id": 72,
          "keys": [
            "I"
          ],
          "effect": "Insert at line start"
        },
        {
          "id": 73,
          "keys": [
            "A"
          ],
          "effect": "Insert at line end"
        },
        {
          "id": 74,
          "keys": [
            "x"
          ],
          "effect": "Delete character"
        },
        {
          "id": 75,
          "keys": [
            "X"
          ],
          "effect": "Delete previous character"
        },
        {
          "id": 76,
          "keys": [
            "d d"
          ],
          "effect": "Cut line"
        },
        {
          "id": 77,
          "keys": [
            "D"
          ],
          "effect": "Cut to line end"
        },
        {
          "id": 78,
          "keys": [
            "c c"
          ],
          "effect": "Change line"
        },
        {
          "id": 79,
          "keys": [
            "C"
          ],
          "effect": "Change to line end"
        },
        {
          "id": 80,
          "keys": [
            "r"
          ],
          "effect": "Then character: replace one character"
        },
        {
          "id": 81,
          "keys": [
            "R"
          ],
          "effect": "Enter replace mode"
        },
        {
          "id": 82,
          "keys": [
            "y y"
          ],
          "effect": "Copy line"
        },
        {
          "id": 83,
          "keys": [
            "p"
          ],
          "effect": "Paste after cursor"
        },
        {
          "id": 84,
          "keys": [
            "P"
          ],
          "effect": "Paste before cursor"
        },
        {
          "id": 85,
          "keys": [
            "u"
          ],
          "effect": "Undo"
        },
        {
          "id": 86,
          "keys": [
            "."
          ],
          "effect": "Repeat last change"
        },
        {
          "id": 87,
          "keys": [
            "~"
          ],
          "effect": "Toggle character case"
        },
        {
          "id": 88,
          "keys": [
            "U"
          ],
          "effect": "Restore whole line"
        }
      ]
    }
  ]
}
