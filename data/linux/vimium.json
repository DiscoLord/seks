{
  "full_name": "Vimium for Firefox",
  "note": "Vimium 2.4.2 for Firefox (not Vimium C). Case matters. Use on permitted web pages; Firefox internal and protected pages block extensions.",
  "source": "https://github.com/philc/vimium",
