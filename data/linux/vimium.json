          "effect": "Scroll down"
        },
        {
          "id": 2,
          "keys": [
            "k",
            "Ctrl+Y"
          ],
          "effect": "Scroll up"
        },
        {
          "id": 3,
          "keys": [
            "h"
          ],
          "effect": "Scroll left"
